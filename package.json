{
  "name": "vue-tailwindcss-with-drizzle-express-api",
  "version": "1.0.0",
  "description": "Full-stack starter template: Vue 3 + Tailwind CSS v4 frontend and Express 5 API with Drizzle ORM and MySQL backend",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run preview --workspace=frontend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "db:check": "npm run db:check --workspace=backend",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:logs": "docker compose logs -f",
    "docker:db": "docker compose up -d mysql",
    "docker:db:push": "node scripts/docker-db.js push",
    "docker:db:migrate": "node scripts/docker-db.js migrate",
    "docker:db:generate": "node scripts/docker-db.js generate",
    "docker:db:check": "node scripts/docker-db.js check",
    "docker:sh": "node scripts/docker-db.js sh"
  },
  "keywords": [
    "vue",
    "vue3",
    "tailwindcss",
    "vite",
    "express",
    "drizzle-orm",
    "mysql",
    "fullstack",
    "template"
  ],
  "author": "MystioDev",
  "license": "ISC"
}
