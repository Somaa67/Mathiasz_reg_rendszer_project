# ==============================================================================
# Full-Stack Application Environment Configuration (.env)
# Used everywhere: Vite, Express, Drizzle ORM, and Docker Compose
# ==============================================================================

# Project Name (used as prefix for containers, compose project, etc.)
PROJECT_NAME=fullstack

# Application Ports
BACKEND_PORT=3000
FRONTEND_PORT=5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=express_drizzle_db
